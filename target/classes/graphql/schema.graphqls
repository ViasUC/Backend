enum RolUsuario { administrador profesor investigador empleador egresado alumno empresa }

type Usuario {
    idUsuario: ID!
    nombre: String!
    apellido: String
    email: String!
    telefono: String
    ubicacion: String
    rolPrincipal: RolUsuario        # ← NO String, usa el enum
    completitud: Int!
    adminData: Administrador
    egresadoData: Egresado
    alumnoData: Alumno
}

type Alumno {
    idUsuario: ID!                  # PK=FK
    usuario: Usuario!               # si realmente es obligatorio, pon !
    carrera: String!
    semestre: Int!
    idAuditoria: Int
}

type Profesor {
    idUsuario: ID!
    departamento: String
    categoriaDocente: String
    areasDocentes: String
    usuario: Usuario!
}

type Investigador {
    idUsuario: ID!
    areasInvestigacion: String
    afiliaciones: String
    hindex: Int
    usuario: Usuario!
}
# =========================
# Oportunidades
# =========================

type Oportunidad {
    id: ID!
    idOportunidad: ID!
    titulo: String
    descripcion: String
    requisitos: String
    ubicacion: String
    modalidad: String
    tipo: String
    fechaPublicacion: String
    fechaCierre: String
    estado: EstadoOportunidad        # en BD: activo/borrador/pausada/cerrado
    creador: Usuario!     # <-- reemplaza a idCreador
    empresa: String
}

enum EstadoOportunidad {
    activo
    borrador
    pausado
    cerrado
}


# =========================
# Postulaciones
# =========================

"""
Estados posibles de la postulación (coinciden con el enum Java EstadoPostulacion).
"""
enum PostulacionEstado {
  PENDIENTE
  ACEPTADA
  RECHAZADA
  CANCELADA
}

type HistorialPostulacion {
  idHistorial: ID!
  estadoAnterior: PostulacionEstado
  estadoNuevo: PostulacionEstado!
  fechaCambio: String!
  motivo: String
  actor: Usuario
}

type Postulacion {
  idPostulacion: ID!
  oportunidad: Oportunidad!
  postulante: Usuario!
  estado: PostulacionEstado!
  fechaPostulacion: String
}

input PostulacionFiltro {
  idOportunidad: ID
  idAlumno: ID
  estados: [PostulacionEstado!]
  fechaDesde: String
  fechaHasta: String
  texto: String
}

type PostulacionPage {
  items: [Postulacion!]!
  total: Int!
  page: Int!
  size: Int!
}

type Canal {
  idCanal: ID!
  nombre: String!
  slug: String!
  tipo: String!
  descripcion: String
  activo: Boolean!
}

type Publicacion {
  idPublicacion: ID!
  titulo: String
  observacion: String
  estado: String
  fechaPublicacion: String
  autor: Usuario
}


# ===== Root types =====
type Query {
    # Usuarios
    usuarios: [Usuario!]!
    usuario(id: ID!): Usuario

    # Alumnos
    alumnos: [Alumno!]!
    alumno(id: ID!): Alumno
    alumnoPorId(id: ID!): Alumno
    consultarPerfil(idUsuario: ID!): AlumnoPerfil
    bolsaTrabajo(filtro: BolsaTrabajoFiltro): [Oportunidad]

    # Oportunidades
    oportunidades: [Oportunidad!]!
    oportunidadesPorEstado(estado: String!): [Oportunidad!]!
    oportunidad(id: ID!): Oportunidad
    oportunidadesPorCreador(creadorId: ID!): [Oportunidad!]!

    # Postulaciones
    postulaciones: [Postulacion]
    postulacionesPorAlumno(idAlumno: ID!): [Postulacion]
    postulacionesPorOportunidad(idOportunidad: ID!): [Postulacion]
    postulacionesPage(
        filtro: PostulacionFiltro
        page: Int = 0
        size: Int = 10
        sort: String = "fechaPostulacion,desc"
    ): PostulacionPage!

    historialPostulacion(idPostulacion: ID!): [HistorialPostulacion!]!

    buscarPostulaciones(
        filters: PostulacionFiltro!
    ): [Postulacion]

    # Endorsements
    endorsementsReceived(toUserId: Int!, status: EndorsementStatus): [Endorsement!]!
    endorsementsGiven(fromUserId: Int!): [Endorsement!]!
    publicEndorsementsOf(userId: Int!): [Endorsement!]!

    canalesActivos: [Canal!]!
    publicacionesDeCanal(idCanal: ID!): [Publicacion!]!

    canalesSeguidos(idUsuario: ID!): [Canal!]!
    feedCanalesSeguidos(idUsuario: ID!): [Publicacion!]!
    canalesPorTipo(tipo: TipoCanal!): [CanalInformacion]
    # Evidencias
    evidenciasPorAlumno(idAlumno: ID!): [Evidencia!]!
    evidenciasPorUsuario(idUsuario: ID!): [Evidencia!]!
    evidenciasPorPortafolio(idPortafolio: ID!): [Evidencia!]!

    # Portafolios
    portafolioPorUsuario(idUsuario: ID!): Portafolio

}


type Mutation {
    # Alumnos
    registrarAlumno(input: RegistroAlumnoInput!): Alumno
    actualizarAlumno(id: ID!, input: AlumnoInput!): Alumno
    crearAlumno(
        nombre: String!
        apellido: String!
        email: String!
        carrera: String!
        semestre: Int!
    ): Alumno

    # Auth
    login(input: LoginInput!): LoginResponse

    # Perfiles
    registrarProfesor(idActor: Int!, input: ProfesorInput!): Profesor!
    registrarInvestigador(idActor: Int!, input: InvestigadorInput!): Investigador!

    actualizarProfesor(id: ID!, input: ProfesorInput): Profesor
    actualizarInvestigador(id: ID!, input: InvestigadorInput): Investigador

    # Postulaciones
    crearPostulacion(
      idAlumno: ID!
      idOportunidad: ID!
      idsEvidencias: [Int] # NUEVO, opcional
    ): Postulacion
    actualizarEstadoPostulacion(
        idPostulacion: ID!
        estado: PostulacionEstado!
        motivo: String
        idActor: ID
    ): Postulacion!

    # Docentes - Oportunidades
    crearOportunidadDocente(input: CrearOportunidadInput!): Oportunidad!
    editarOportunidad(input: EditarOportunidadInput!): Oportunidad!

    # Endorsements
    createEndorsement(input: CreateEndorsementInput!): Endorsement!
    decideEndorsement(id: ID!, accept: Boolean!): Endorsement!

    # --- Portafolio ---
    crearPortafolio(input: GuardarPortafolioInput!): Portafolio
    actualizarPortafolio(input: GuardarPortafolioInput!): Portafolio

    # --- Evidencias ---
    agregarEvidencia(input: CrearEvidenciaInput!): Evidencia
    editarEvidencia(input: EditarEvidenciaInput!): Evidencia
    eliminarEvidencia(idEvidencia: Int!, idUsuario: Int!): Boolean
    crearCanal(input: CrearCanalInput!): Canal!
    crearPublicacionEnCanal(input: CrearPublicacionEnCanalInput!): Publicacion!

    seguirCanal(idCanal: ID!, idUsuario: ID!): Boolean
    dejarDeSeguirCanal(idCanal: ID!, idUsuario: ID!): Boolean!
    destacarPublicacion(idCanal: ID!, idPublicacion: ID!, destacado: Boolean!): Boolean!


}

# =========================
# Inputs
# =========================

input AlumnoInput {
    usuario: UsuarioInput
    carrera: String
    semestre: Int
}

input BolsaTrabajoFiltro {
    ubicacion: String
    modalidad: String
    empresa: String
}

#-type PublicacionOutput {
    #idOportunidad: ID
    #id: ID
    #titulo: String
    #descripcion: String
    #tipo: String
   # ubicacion: String
    #modalidad: String
   # empresa: String
#}#

# --- Inputs para registro (alta) ---
input UsuarioRegistroInput {
    nombre: String!
    apellido: String
    email: String!
    telefono: String
    ubicacion: String
    password: String!
    rolPrincipal: RolUsuario = alumno
    completitud: Int = 0
}

type AlumnoPerfil {
    nombre: String
    apellido: String
    email: String
    telefono: String
    ubicacion: String
    carrera: String
    semestre: Int
} #se crea para consultar info del perfil

input RegistroAlumnoInput {
    usuario: UsuarioRegistroInput!
    carrera: String!
    semestre: Int!
    detalleAuditoria: String = "registro alumno"
}
input CrearOportunidadInput {
  idCreador: ID!          # temporal hasta tomarlo del token en backend
  titulo: String!
  descripcion: String
  requisitos: String
  ubicacion: String
  modalidad: String!      # "presencial" | "remoto" | "híbrido"
  tipo: String!           # "pasantía" | "empleo" | ...
  fechaCierre: String
  estado: EstadoOportunidad          # default backend: "activo"
}

input EditarOportunidadInput {
  idOportunidad: Int!
  idEditor: ID!
  titulo: String
  descripcion: String
  requisitos: String
  ubicacion: String
  modalidad: String
  tipo: String
  fechaCierre: String
  estado: EstadoOportunidad
}


input CrearCanalInput {
  nombre: String!
  slug: String!
  tipo: String!
  descripcion: String
  actorId: ID!
}

input CrearPublicacionEnCanalInput {
  idCanal: ID!
  idProyectoF7: ID!   # el proyecto genérico F7 en la BD
  titulo: String
  idAutor: ID!
  contenido: String!
}



input GuardarPortafolioInput {
    idUsuario: Int!
    descripcion: String
    skills: String
    visibilidad: Boolean
}

input CrearEvidenciaInput {
  idPortafolio: Int!
  idUsuario: Int!        # NUEVO
  titulo: String
  descripcion: String
  tipo: String
  recurso: String
}


input EditarEvidenciaInput {
  idEvidencia: Int!
  idUsuario: Int!        # NUEVO
  titulo: String
  descripcion: String
  tipo: String
  recurso: String
}


enum EndorsementStatus { PENDING ACCEPTED REJECTED }

type Endorsement {
  idEndorsement: ID!
  fromUserId: Int!
  toUserId: Int!
  skill: String
  message: String
  status: EndorsementStatus!
  createdAt: String
  decidedAt: String
}

input CreateEndorsementInput {
  fromUserId: Int!
  toUserId: Int!
  skill: String
  message: String
}

input DecideEndorsementInput {
  id: ID!
  actorId: Int!     # el usuario que está intentando aceptar/rechazar
  accept: Boolean!
}

input LoginInput {
  email: String!
  password: String!
}
type LoginResponse {
    idUsuario: ID!
    nombre: String
    apellido: String
    rolPrincipal: RolUsuario
}

# --- Inputs para alta de profesor/investigador ---
input UsuarioInput {
  nombre: String
  apellido: String
  email: String
  telefono: String
  ubicacion: String
  password: String
}

input ProfesorInput {
  usuario: UsuarioInput!
  departamento: String
  categoriaDocente: String
  areasDocentes: String
}

input InvestigadorInput {
  usuario: UsuarioInput!
  areasInvestigacion: String
  afiliaciones: String
  hindex: Int
}




# --- Datos extendidos ---
type Administrador {
    idUsuario: Int!
    titulo: String
    descripcion: String
}

type Egresado {
    idUsuario: Int!
    anioEgreso: Int!
}


# --- Portafolio ---
type Portafolio {
    idPortafolio: Int!
    # idUsuario: Int!
    descripcion: String
    skills: String
    visibilidad: Boolean
    ultimaActualizacion: String
    idAuditoria: Int
    evidencias: [Evidencia!]!
}

type Evidencia {
    idEvidencia: Int!
    idPortafolio: Int!
    titulo: String
    descripcion: String
    tipo: String
    recurso: String
    idAuditoria: Int
}

type CanalInformacion {
  idCanal: ID!
  nombre: String!
  slug: String!
  tipo: String!
  descripcion: String
  activo: Boolean!
}

enum TipoCanal {
  OFERTAS
  EVENTOS
  INNOVACION
  NOTICIAS_INSTITUCIONALES
}



