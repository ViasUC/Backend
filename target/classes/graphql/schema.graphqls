# =========================
# Usuario / Alumno
# =========================

type Usuario {
  idUsuario: ID!
  nombre: String!
  apellido: String
  email: String!
  rolPrincipal: String
  completitud: Int!
}

type Alumno {
  # PK = FK a usuarios.id_usuario
  idUsuario: ID!
  usuario: Usuario
  carrera: String
  semestre: Int
}

# =========================
# Oportunidades
# =========================

type Oportunidad {
  idOportunidad: ID!
  titulo: String
  descripcion: String
  requisitos: String
  ubicacion: String
  modalidad: String
  tipo: String
  fechaPublicacion: String
  fechaCierre: String
  estado: String        # en BD: activo/borrador/pausada/cerrado
  creador: Usuario!     # <-- reemplaza a idCreador
}

# =========================
# Postulaciones
# =========================

"""
Estados posibles de la postulación (coinciden con el enum Java EstadoPostulacion).
"""
enum PostulacionEstado {
  PENDIENTE
  ACEPTADA
  RECHAZADA
  CANCELADA
}

type HistorialPostulacion {
  idHistorial: ID!
  estadoAnterior: PostulacionEstado
  estadoNuevo: PostulacionEstado!
  fechaCambio: String!
  motivo: String
  actor: Usuario
}

type Postulacion {
  idPostulacion: ID!
  alumno: Alumno!
  oportunidad: Oportunidad!
  postulante: Usuario!
  estado: PostulacionEstado!
  fechaPostulacion: String
}

input PostulacionFiltro {
  idOportunidad: ID
  idAlumno: ID
  estados: [PostulacionEstado!]
  fechaDesde: String
  fechaHasta: String
  texto: String
}

type PostulacionPage {
  items: [Postulacion!]!
  total: Int!
  page: Int!
  size: Int!
}

# =========================
# Query
# =========================

type Query {
  # Usuarios
  usuarios: [Usuario!]!
  usuario(id: ID!): Usuario

  # Alumnos
  alumnos: [Alumno!]!
  alumno(id: ID!): Alumno
  alumnoPorId(id: ID!): Alumno

  # Oportunidades
  oportunidades: [Oportunidad!]!
  oportunidadesPorEstado(estado: String!): [Oportunidad!]!

  # Postulaciones (existentes)
  postulaciones: [Postulacion]
  postulacionesPorAlumno(idAlumno: ID!): [Postulacion]
  postulacionesPorOportunidad(idOportunidad: ID!): [Postulacion]

  # Postulaciones (F1)
  postulacionesPage(
    filtro: PostulacionFiltro
    page: Int = 0
    size: Int = 10
    sort: String = "fechaPostulacion,desc"
  ): PostulacionPage!

  historialPostulacion(idPostulacion: ID!): [HistorialPostulacion!]!
}

# =========================
# Mutation
# =========================

type Mutation {
  # Alumnos
  crearAlumno(
    nombre: String!
    apellido: String!
    email: String!
    carrera: String!
    semestre: Int!
  ): Alumno

  # Postulaciones
  crearPostulacion(idAlumno: ID!, idOportunidad: ID!): Postulacion

  actualizarEstadoPostulacion(
    idPostulacion: ID!
    estado: PostulacionEstado!
    motivo: String
    idActor: ID
  ): Postulacion!
}
