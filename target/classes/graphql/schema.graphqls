# =========================
# Usuario / Alumno
# =========================

type Usuario {
  idUsuario: ID!
  nombre: String!
  apellido: String
  email: String!
  rolPrincipal: String
  completitud: Int!
}

type Alumno {
  # PK = FK a usuarios.id_usuario
  idUsuario: ID!
  usuario: Usuario
  carrera: String
  semestre: Int
}

# =========================
# Oportunidades
# =========================

type Oportunidad {
  idOportunidad: ID!
  titulo: String
  descripcion: String
  requisitos: String
  ubicacion: String
  modalidad: String
  tipo: String
  fechaPublicacion: String
  fechaCierre: String
  estado: String        # en BD: activo/borrador/pausada/cerrado
  creador: Usuario!     # <-- reemplaza a idCreador
}

# =========================
# Postulaciones
# =========================

"""
Estados posibles de la postulación (deben coincidir con el enum Java Postulacion.EstadoPostulacion).
"""
enum PostulacionEstado {
  PENDIENTE
  ACEPTADA
  RECHAZADA
}

type HistorialPostulacion {
  idHistorial: ID!
  estadoAnterior: PostulacionEstado
  estadoNuevo: PostulacionEstado!
  fechaCambio: String!
  motivo: String
}

type Postulacion {
  idPostulacion: ID!
  alumno: Alumno!
  oportunidad: Oportunidad!
  postulante: Usuario!
  estado: String!
  fechaPostulacion: String
}

# =========================
# Query
# =========================

type Query {
  # Usuarios
  usuarios: [Usuario!]!
  usuario(id: ID!): Usuario

  # Alumnos
  alumnos: [Alumno!]!
  alumno(id: ID!): Alumno
  alumnoPorId(id: ID!): Alumno

  # Oportunidades
  oportunidades: [Oportunidad!]!
  oportunidadesPorEstado(estado: String!): [Oportunidad!]!

  # Postulaciones
    postulaciones: [Postulacion]
    postulacionesPorAlumno(idAlumno: ID!): [Postulacion]
    postulacionesPorOportunidad(idOportunidad: ID!): [Postulacion]

}

# =========================
# Mutation
# =========================

type Mutation {
  # Alumnos
  crearAlumno(
    nombre: String!
    apellido: String!
    email: String!
    carrera: String!
    semestre: Int!
  ): Alumno

  # Postulaciones (F1)
  crearPostulacion(idAlumno: ID!, idOportunidad: ID!): Postulacion


  actualizarEstadoPostulacion(
    idPostulacion: ID!
    estado: PostulacionEstado!
    motivo: String
  ): Postulacion!
}
