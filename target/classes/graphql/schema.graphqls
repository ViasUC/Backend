enum RolUsuario { administrador profesor investigador empleador egresado alumno empresa }

type AuthPayload {
    token: String
    usuario: Usuario
    success: Boolean!
    message: String
}

type Usuario {
    idUsuario: ID!
    nombre: String!
    apellido: String
    email: String
    telefono: String
    ubicacion: String
    rolPrincipal: RolUsuario        # ← NO String, usa el enum
    completitud: Int!
    adminData: Administrador
    egresadoData: Egresado
    alumnoData: Alumno
}

type Alumno {
    idUsuario: ID!                  # PK=FK
    usuario: Usuario!               # si realmente es obligatorio, pon !
    carrera: String!
    semestre: Int!
    idAuditoria: Int
}

type Profesor {
    idUsuario: ID!
    departamento: String
    categoriaDocente: String
    areasDocentes: String
    usuario: Usuario!
}

type Investigador {
    idUsuario: ID!
    areasInvestigacion: String
    afiliaciones: String
    hindex: Int
    usuario: Usuario!
}
