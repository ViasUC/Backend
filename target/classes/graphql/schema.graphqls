enum EndorsementStatus { PENDING ACCEPTED REJECTED }

type Endorsement {
  idEndorsement: ID!
  fromUserId: Int!
  toUserId: Int!
  skill: String
  message: String
  status: EndorsementStatus!
  createdAt: String
  decidedAt: String
}

input CreateEndorsementInput {
  fromUserId: Int!
  toUserId: Int!
  skill: String
  message: String
}

input DecideEndorsementInput {
  id: ID!
  actorId: Int!     # el usuario que está intentando aceptar/rechazar
  accept: Boolean!
}

input LoginInput {
  email: String!
  password: String!
}
type LoginResponse {
    token: String!
    idUsuario: ID!
    nombre: String
    apellido: String
    rolPrincipal: RolUsuario
    idEmpresa: Int
}

# --- Inputs para alta de profesor/investigador ---
input UsuarioInput {
  nombre: String
  apellido: String
  email: String
  telefono: String
  ubicacion: String
  password: String
}

input ProfesorInput {
  usuario: UsuarioInput!
  departamento: String
  categoriaDocente: String
  areasDocentes: String
}

input InvestigadorInput {
  usuario: UsuarioInput!
  areasInvestigacion: String
  afiliaciones: String
  hindex: Int
}




# --- Datos extendidos ---
type Administrador {
    idUsuario: Int!
    titulo: String
    descripcion: String
}

type Egresado {
    idUsuario: Int!
    anioEgreso: Int!
}


# --- Portafolio ---
type Portafolio {
    idPortafolio: Int!
    # idUsuario: Int!
    descripcion: String
    skills: String
    visibilidad: Boolean
    ultimaActualizacion: String
    idAuditoria: Int
    evidencias: [Evidencia!]!
    # Datos del usuario para búsqueda
    nombre: String
    apellido: String
    email: String
    telefono: String
    ubicacion: String
    carrera: String
}

type Evidencia {
    idEvidencia: Int!
    idPortafolio: Int!
    titulo: String
    descripcion: String
    tipo: String
    recurso: String
    idAuditoria: Int
}

type CanalInformacion {
  idCanal: ID!
  nombre: String!
  slug: String!
  tipo: String!
  descripcion: String
  activo: Boolean!
}

enum TipoCanal {
  OFERTAS
  EVENTOS
  INNOVACION
  NOTICIAS_INSTITUCIONALES
}
# =========================
# Empresa
# =========================

type Empresa {
    idEmpresa: Int!
    nombreEmpresa: String!
    ruc: String
    razonSocial: String
    contacto: String
    ubicacion: String
    email: String
    descripcion: String
}

input ActualizarEmpresaInput {
    nombreEmpresa: String!
    ruc: String
    razonSocial: String
    contacto: String
    ubicacion: String
    email: String
    descripcion: String
}

type ActualizarEmpresaResponse {
    success: Boolean!
    message: String!
    empresa: Empresa
}

extend type Query {
    miEmpresa(idUsuario: ID!): Empresa
}


# Inputs y tipos para registro
input RegisterInput {
    tipoUsuario: String!
    nombre: String!
    apellido: String!
    email: String!
    telefono: String!
    password: String!
    ubicacion: String
    # Datos de empresa (solo para EMPLEADOR - crear nueva)
    nombreEmpresa: String
    ruc: String
    razonSocial: String
    contacto: String
    ubicacionEmpresa: String
    emailEmpresa: String
    # Datos para unirse a empresa existente (solo para EMPLEADOR)
    idEmpresaExistente: Int
    rolSolicitado: RolEmpresa
}

type RegisterResponse {
    token: String!
    usuario: UserRegistered!
    success: Boolean!
    message: String!
}

type UserRegistered {
    idUsuario: ID!
    nombre: String!
    apellido: String!
    email: String!
    rol: String!
}

# =========================
# Búsqueda de Portafolios
# =========================

input FiltrosBusqueda {
    textoBusqueda: String
    carrera: String
    ubicacion: String
    habilidades: [String]
    pagina: Int
    limite: Int
}

type PortafolioBusqueda {
    idPortafolio: Int
    usuarioId: Int
    nombre: String
    apellido: String
    email: String
    telefono: String
    carrera: String
    ubicacion: String
    descripcion: String
    skills: String
}

type ResultadoBusqueda {
    portafolios: [PortafolioBusqueda!]!
    total: Int!
    pagina: Int!
    totalPaginas: Int!
}

type FiltrosDisponibles {
    carreras: [String!]!
    ubicaciones: [String!]!
}

