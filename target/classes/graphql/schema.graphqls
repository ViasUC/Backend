# --- Tipos base ---
enum RolUsuario {
  administrador
  profesor
  investigador
  egresado
  alumno
  empresa
}

type Usuario {
  idUsuario: ID!
  nombre: String!
  apellido: String
  email: String!
  telefono: String
  ubicacion: String
  rolPrincipal: RolUsuario
  completitud: Int
}

type Alumno {
  idUsuario: ID!
  carrera: String!
  semestre: Int!
  idAuditoria: Int!
  usuario: Usuario!
}

# --- Queries ---
type Query {
  alumnos: [Alumno!]!
  alumno(id: ID!): Alumno
  alumnoPorEmail(email: String!): Alumno
}

# --- Inputs para actualización parcial ---
input UsuarioInput {
  nombre: String
  apellido: String
  email: String
  telefono: String
  ubicacion: String
}

input AlumnoInput {
  usuario: UsuarioInput
  carrera: String
  semestre: Int
}

# --- Inputs para registro (alta) ---
input UsuarioRegistroInput {
  nombre: String!
  apellido: String
  email: String!
  telefono: String
  ubicacion: String
  password: String!
  rolPrincipal: RolUsuario = alumno
  completitud: Int = 0
}

input RegistroAlumnoInput {
  usuario: UsuarioRegistroInput!
  carrera: String!
  semestre: Int!
  detalleAuditoria: String = "registro alumno"
}

# --- Input para login ---
input LoginInput {
  email: String!
  password: String!
}

# --- Mutations ---
type Mutation {
  registrarAlumno(input: RegistroAlumnoInput!): Alumno!
  actualizarAlumno(id: ID!, input: AlumnoInput): Alumno
  login(input: LoginInput!): Usuario
}
