    # Portafolios
    portafolioPorUsuario(idUsuario: ID!): Portafolio
    buscarPortafolios(filtros: FiltrosBusqueda): ResultadoBusqueda!
    obtenerFiltros: FiltrosDisponibles!
}


type Mutation {
    # Alumnos
    registrarAlumno(input: RegistroAlumnoInput!): Alumno
    actualizarAlumno(id: ID!, input: AlumnoInput!): Alumno
    crearAlumno(
        nombre: String!
        apellido: String!
        email: String!
        carrera: String!
        semestre: Int!
    ): Alumno

    # Auth
    login(input: LoginInput!): LoginResponse
    # loginDocenteInvestigador(input: LoginInput!): AuthPayload!  # TODO: Definir AuthPayload type
    register(input: RegisterInput!): RegisterResponse!

    # Perfiles
    registrarProfesor(idActor: Int!, input: ProfesorInput!): Profesor!
    registrarInvestigador(idActor: Int!, input: InvestigadorInput!): Investigador!

    actualizarProfesor(id: ID!, input: ProfesorInput): Profesor
    actualizarInvestigador(id: ID!, input: InvestigadorInput): Investigador

    # Postulaciones
    crearPostulacion(
      idAlumno: ID!
      idOportunidad: ID!
      idsEvidencias: [Int] # NUEVO, opcional
    ): Postulacion
    actualizarEstadoPostulacion(
        idPostulacion: ID!
        estado: PostulacionEstado!
        motivo: String
        idActor: ID
    ): Postulacion!

    # Docentes - Oportunidades
    crearOportunidadDocente(input: CrearOportunidadInput!): Oportunidad!
    editarOportunidad(input: EditarOportunidadInput!): Oportunidad!
    cambiarEstadoOportunidad(idOportunidad: ID!, nuevoEstado: EstadoOportunidad!, idActor: ID!): Oportunidad!

    # Endorsements
    createEndorsement(input: CreateEndorsementInput!): Endorsement!
    decideEndorsement(id: ID!, accept: Boolean!): Endorsement!

    # --- Portafolio ---
    crearPortafolio(input: GuardarPortafolioInput!): Portafolio
    actualizarPortafolio(input: GuardarPortafolioInput!): Portafolio

    # --- Evidencias ---
    agregarEvidencia(input: CrearEvidenciaInput!): Evidencia
    editarEvidencia(input: EditarEvidenciaInput!): Evidencia
    eliminarEvidencia(idEvidencia: Int!, idUsuario: Int!): Boolean
    crearCanal(input: CrearCanalInput!): Canal!
    crearPublicacionEnCanal(input: CrearPublicacionEnCanalInput!): Publicacion!

    seguirCanal(idCanal: ID!, idUsuario: ID!): Boolean
    dejarDeSeguirCanal(idCanal: ID!, idUsuario: ID!): Boolean!
    destacarPublicacion(idCanal: ID!, idPublicacion: ID!, destacado: Boolean!): Boolean!
    # --- Empresa ---
    actualizarEmpresa(input: ActualizarEmpresaInput!, idUsuario: ID!): ActualizarEmpresaResponse!

}

