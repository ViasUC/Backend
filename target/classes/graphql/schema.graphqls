    #titulo: String
    #descripcion: String
    #tipo: String
   # ubicacion: String
    #modalidad: String
   # empresa: String
#}#

# --- Inputs para registro (alta) ---
input UsuarioRegistroInput {
    nombre: String!
    apellido: String
    email: String!
    telefono: String
    ubicacion: String
    password: String!
    rolPrincipal: RolUsuario = alumno
    completitud: Int = 0
}

type AlumnoPerfil {
    nombre: String
    apellido: String
    email: String
    telefono: String
    ubicacion: String
    carrera: String
    semestre: Int
} #se crea para consultar info del perfil

input RegistroAlumnoInput {
    usuario: UsuarioRegistroInput!
    carrera: String!
    semestre: Int!
    detalleAuditoria: String = "registro alumno"
}

enum EndorsementStatus { PENDING ACCEPTED REJECTED }

type Endorsement {
  idEndorsement: ID!
  fromUserId: Int!
  toUserId: Int!
  skill: String
  message: String
  status: EndorsementStatus!
  createdAt: String
  decidedAt: String
}

input CreateEndorsementInput {
  toUserId: Int!
  skill: String
  message: String
}

input LoginInput {
  email: String!
  password: String!
}
type LoginResponse {
    token: String!
    idUsuario: ID!
    nombre: String
    apellido: String
    rolPrincipal: RolUsuario
}


type AuthPayload {
  token: String!
  usuario: Usuario!
}


# --- Inputs para alta de profesor/investigador ---
input UsuarioInput {
  nombre: String
  apellido: String
  email: String
  telefono: String
  ubicacion: String
  password: String
}

input ProfesorInput {
  usuario: UsuarioInput!
  departamento: String
  categoriaDocente: String
  areasDocentes: String
}

input InvestigadorInput {
  usuario: UsuarioInput!
  areasInvestigacion: String
  afiliaciones: String
  hindex: Int
}




# --- Datos extendidos ---
type Administrador {
    idUsuario: Int!
    titulo: String
    descripcion: String
}

type Egresado {
    idUsuario: Int!
    anioEgreso: Int!
}


# --- Portafolio ---
type Portafolio {
    idPortafolio: Int!
    idUsuario: Int!
    descripcion: String
    skills: String
    visibilidad: String
    ultimaActualizacion: String
    evidencias: [Evidencia!]!
    # Datos del usuario para búsqueda
    nombre: String
    apellido: String
    email: String
    telefono: String
    ubicacion: String
    carrera: String
}

type Evidencia {
    idEvidencia: Int!
    idPortafolio: Int!
    titulo: String
    descripcion: String
    tipo: String
    recurso: String
}

# =========================
# Empresa
# =========================

type Empresa {
    id: ID!
    nombreEmpresa: String!
    ruc: String
    razonSocial: String
    contacto: String
    ubicacion: String
    email: String
    descripcion: String
}

input ActualizarEmpresaInput {
    nombreEmpresa: String!
    ruc: String
    razonSocial: String
    contacto: String
    ubicacion: String
    email: String
    descripcion: String
}

type ActualizarEmpresaResponse {
    success: Boolean!
    message: String!
    empresa: Empresa
}

extend type Query {
    miEmpresa(idUsuario: ID!): Empresa
}

extend type Mutation {
    actualizarEmpresa(input: ActualizarEmpresaInput!, idUsuario: ID!): ActualizarEmpresaResponse!
}

# Inputs y tipos para registro
input RegisterInput {
    tipoUsuario: String!
    nombre: String!
    apellido: String!
    email: String!
    telefono: String!
    password: String!
    ubicacion: String
    # Datos de empresa (solo para EMPLEADOR)
    nombreEmpresa: String
    ruc: String
    razonSocial: String
    contacto: String
    ubicacionEmpresa: String
    emailEmpresa: String
    rolEnEmpresa: String
}

type RegisterResponse {
    token: String!
    usuario: UserRegistered!
    success: Boolean!
    message: String!
}

type UserRegistered {
    idUsuario: ID!
    nombre: String!
    apellido: String!
    email: String!
    rol: String!
}

# =========================
# Búsqueda de Portafolios
# =========================

input FiltrosBusqueda {
    textoBusqueda: String
    carrera: String
    ubicacion: String
    habilidades: [String]
    pagina: Int
    limite: Int
}

type PortafolioBusqueda {
    idPortafolio: Int
    usuarioId: Int
    nombre: String
    apellido: String
    email: String
    telefono: String
    carrera: String
    ubicacion: String
    descripcion: String
    skills: String
}

type ResultadoBusqueda {
    portafolios: [PortafolioBusqueda!]!
    total: Int!
    pagina: Int!
    totalPaginas: Int!
}

type FiltrosDisponibles {
    carreras: [String!]!
    ubicaciones: [String!]!
}

# =========================
# Estados de la oportunidad laboral.
# =========================

enum EstadoOportunidad {
  BORRADOR
  ACTIVA
  PAUSADA
  CERRADA
}

type Oportunidad {
  id: ID!
  idOportunidad: ID!
  titulo: String
  descripcion: String
  requisitos: String
  ubicacion: String
  modalidad: String
  tipo: String
  fechaPublicacion: String
  fechaCierre: String
  estado: EstadoOportunidad
  creador: Usuario!
  empresa: String
}

input CrearOportunidadInput {
  idCreador: ID!          # por ahora, lo mandamos desde el front
  titulo: String!
  descripcion: String
  requisitos: String
  ubicacion: String
  modalidad: String!
  tipo: String!
  fechaCierre: String
}

extend type Mutation {
  crearOportunidadEmpresa(input: CrearOportunidadInput!): Oportunidad!
  actualizarOportunidad(id: ID!, input: CrearOportunidadInput!): Oportunidad!
  cambiarEstadoOportunidad(id: ID!, estado: EstadoOportunidad!, idActor: ID!): Oportunidad!
  eliminarOportunidad(id: ID!, idActor: ID!): Boolean!
}
