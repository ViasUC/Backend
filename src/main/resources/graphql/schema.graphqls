# --- Tipos base ---
enum RolUsuario {
  administrador
  profesor
  investigador
  empleador
  egresado
  alumno
  empresa
}

type Usuario {
  idUsuario: ID!
  nombre: String!
  apellido: String
  email: String!
  telefono: String
  ubicacion: String
  rolPrincipal: RolUsuario
  completitud: Int

  adminData: Administrador
  egresadoData: Egresado
  alumnoData: Alumno
}

# --- Queries ---
type Query {
  alumnos: [Alumno!]!
  alumno(id: ID!): Alumno
  alumnoPorEmail(email: String!): Alumno
  usuarioById(id: Int!): Usuario
  usuarios: [Usuario!]!   # <-- ANTES TENÍAS EL EXTEND TYPE, AHORA LO UNIFICO AQUÍ
  portafolioPorUsuario(idUsuario: Int!): Portafolio   # <-- AQUÍ VA TU NUEVA QUERY
}

# --- Inputs para actualización parcial ---
input UsuarioInput {
  nombre: String
  apellido: String
  email: String
  telefono: String
  ubicacion: String
}

input AlumnoInput {
  usuario: UsuarioInput
  carrera: String
  semestre: Int
}

# --- Inputs para registro ---
input UsuarioRegistroInput {
  nombre: String!
  apellido: String
  email: String!
  telefono: String
  ubicacion: String
  password: String!
  rolPrincipal: RolUsuario = alumno
  completitud: Int = 0
}

input RegistroAlumnoInput {
  usuario: UsuarioRegistroInput!
  carrera: String!
  semestre: Int!
  detalleAuditoria: String = "registro alumno"
}

# --- Input para login ---
input LoginInput {
  email: String!
  password: String!
}

# --- Mutations ---
type Mutation {
  registrarAlumno(input: RegistroAlumnoInput!): Alumno!
  actualizarAlumno(id: ID!, input: AlumnoInput): Alumno
  login(input: LoginInput!): Usuario
    # Alta (crea usuario + alumno + auditoría)
    registrarAlumno(input: RegistroAlumnoInput!): Alumno!

    # Tu mutación existente para actualizar datos parcialmente
    actualizarAlumno(id: ID!, input: AlumnoInput): Alumno

    #login(input: LoginInput!): LoginResponse
}

