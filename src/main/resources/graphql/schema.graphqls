# =========================================
# ENUMS
# =========================================
enum RolUsuario {
  administrador
  profesor
  investigador
  empleador
  egresado
  alumno
  empresa
}

# =========================================
# TIPOS PRINCIPALES
# =========================================
type Usuario {
  idUsuario: ID!
  nombre: String!
  apellido: String
  email: String!
  telefono: String
  ubicacion: String
  rolPrincipal: RolUsuario
  completitud: Int

  adminData: Administrador
  egresadoData: Egresado
  alumnoData: Alumno
}

type Administrador {
  idUsuario: Int!
  titulo: String
  descripcion: String
}

type Egresado {
  idUsuario: Int!
  anioEgreso: Int!
  titulo: String
}

type Alumno {
  idUsuario: ID!
  carrera: String!
  semestre: Int!
  idAuditoria: Int!
  usuario: Usuario!
}

# =========================================
# PORTAFOLIO
# =========================================
type Portafolio {
  idPortafolio: Int!
  idUsuario: Int!
  descripcion: String
  skills: String
  visibilidad: String
  ultimaActualizacion: String
  evidencias: [Evidencia!]!
}

type Postulacion {
  idPostulacion: ID!
  idOportunidad: Int!
  idPostulante: Int!
  idOfertante: Int!
  fechaPostulacion: String
  estado: String
  motivo: String
  idAuditoria: Int
}

type Evidencia {
  idEvidencia: Int!
  idPortafolio: Int!
  titulo: String
  descripcion: String
  tipo: String
  recurso: String
}

# =========================================
# CONEXIONES Y SOLICITUDES
# =========================================
type Conexion {
  idConexion: Int
  idUsuario1: Int
  idUsuario2: Int
  fechaConexion: String
  idAuditoria: Int
}

type SolicitudConexion {
  idSolicitud: Int!
  idUsuarioOrigen: Int!
  idUsuarioDestino: Int!
  estado: String!
  fechaSolicitud: String
  fechaRespuesta: String
}

# =========================================
# OPORTUNIDADES
# =========================================
type Oportunidad {
  idOportunidad: ID!
  idEmpresa: Int
  idCreador: Int
  titulo: String
  descripcion: String
  requisitos: String
  ubicacion: String
  modalidad: String
  tipo: String
  fechaPublicacion: String
  fechaCierre: String
  estado: String
  idAuditoria: Int
}

# =========================================
# QUERIES
# =========================================
type Query {
  alumnos: [Alumno!]!
  alumno(id: ID!): Alumno
  alumnoPorEmail(email: String!): Alumno

  usuarioById(id: Int!): Usuario
  usuarios: [Usuario!]!

  conexionesPorUsuario(idUsuario: Int!): [Conexion]
  portafolioPorUsuario(idUsuario: Int!): Portafolio

  solicitudesRecibidas(idUsuario: Int!): [SolicitudConexion]
  solicitudesEnviadas(idUsuario: Int!): [SolicitudConexion]
  solicitudesPendientes(idUsuario: Int!): [SolicitudConexion]

  oportunidades: [Oportunidad]
  oportunidadById(id: Int!): Oportunidad
  postulacionesPorUsuario(idUsuario: Int!): [Postulacion]

}

# =========================================
# INPUTS
# =========================================
input UsuarioInput {
  nombre: String
  apellido: String
  email: String
  telefono: String
  ubicacion: String
}

input AlumnoInput {
  usuario: UsuarioInput
  carrera: String
  semestre: Int
}

input UsuarioRegistroInput {
  nombre: String!
  apellido: String
  email: String!
  telefono: String
  ubicacion: String
  password: String!
  rolPrincipal: RolUsuario = alumno
  completitud: Int = 0
}

input RegistroAlumnoInput {
  usuario: UsuarioRegistroInput!
  carrera: String!
  semestre: Int!
  detalleAuditoria: String = "registro alumno"
}

input LoginInput {
  email: String!
  password: String!
}

type LoginResponse {
  idUsuario: ID!
  nombre: String
  apellido: String
  rolPrincipal: RolUsuario
}

input EgresadoInput {
  anioEgreso: Int
  titulo: String
}

# =========================================
# MUTATIONS
# =========================================
type Mutation {

  registrarAlumno(input: RegistroAlumnoInput!): Alumno
  actualizarAlumno(id: ID!, input: AlumnoInput): Alumno

  login(input: LoginInput!): LoginResponse
  actualizarUsuario(idUsuario: Int!, input: UsuarioInput): Usuario
  actualizarEgresado(id: Int!, input: EgresadoInput!): Egresado

  enviarSolicitud(origen: Int!, destino: Int!): SolicitudConexion
  aceptarSolicitud(idSolicitud: Int!): SolicitudConexion
  rechazarSolicitud(idSolicitud: Int!): Boolean

  crearOportunidad(
    idEmpresa: Int
    idCreador: Int
    titulo: String
    descripcion: String
    requisitos: String
    ubicacion: String
    modalidad: String
    tipo: String
    fechaPublicacion: String
    fechaCierre: String
    estado: String
  ): Oportunidad

  # 🟦🔥 ESTA ES LA MUTATION QUE TE FALTABA PARA EDITAR
  actualizarOportunidad(
    idOportunidad: Int!
    idCreador: Int!
    titulo: String!
    descripcion: String!
    requisitos: String!
    ubicacion: String!
    modalidad: String!
    tipo: String!
    fechaCierre: String
    estado: String!
  ): Oportunidad
  
  eliminarOportunidad(idOportunidad: Int!): Boolean
crearPostulacion(
  idOportunidad: Int!
  idPostulante: Int!
  idOfertante: Int!
): Postulacion

eliminarPostulacion(
  idPostulante: Int!,
  idOportunidad: Int!
): Boolean

}
