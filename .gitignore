target/
target/**

# Paquetes (si no publicás binarios en el repo)
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Mantener el wrapper de Maven aunque se ignore *.jar
!/.mvn/wrapper/maven-wrapper.jar

